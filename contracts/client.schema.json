{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SiteForge Client Truth Contract",
    "type": "object",
  
    "required": [
      "meta",
      "business_identity",
      "contact",
      "services"
    ],
  
    "properties": {
  
      "meta": {
        "type": "object",
        "required": [
          "client_id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
  
      "business_identity": {
        "type": "object",
        "required": [
          "business_name"
        ],
        "properties": {
  
          "business_name": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "tagline": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "description": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "primary_offer": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "target_audience": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "service_area": {
            "$ref": "#/$defs/provenanceField"
          }
        }
      },
  
      "contact": {
        "type": "object",
        "properties": {
  
          "phone": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "email": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "website": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "address": {
            "$ref": "#/$defs/provenanceField"
          },
  
          "hours": {
            "$ref": "#/$defs/provenanceField"
          }
        }
      },
  
      "services": {
        "type": "array",
  
        "items": {
          "type": "object",
  
          "required": [
            "name"
          ],
  
          "properties": {
  
            "name": {
              "$ref": "#/$defs/provenanceField"
            },
  
            "description": {
              "$ref": "#/$defs/provenanceField"
            },
  
            "priority": {
              "type": "string"
            }
          }
        }
      },
  
      "assets": {
        "type": "object",
  
        "properties": {
  
          "logo": {
            "type": "string"
          },
  
          "gallery_images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
  
      "approvals": {
        "type": "object",
  
        "properties": {
  
          "strategy_approved": {
            "type": "boolean"
          },
  
          "visual_direction_approved": {
            "type": "boolean"
          },
  
          "final_build_approved": {
            "type": "boolean"
          }
        }
      }
  
    },
  
    "$defs": {
  
      "provenanceField": {
  
        "type": "object",
  
        "required": [
          "value"
        ],
  
        "properties": {
  
          "value": {},
  
          "source": {
            "type": "string",
            "enum": [
              "client_confirmed",
              "recon_inferred",
              "ai_suggested",
              "manual_override",
              "imported"
            ]
          },
  
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
  
          "updated_at": {
            "type": "string"
          }
        }
      }
    }
  }